# =====================================
# APP
# =====================================
APP_URL=http://localhost:3000
NODE_ENV=development

# =====================================
# DATABASE
# =====================================
# SQLite default for local development:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/hindi_shorts?schema=public"

# =====================================
# GEMINI AI
# =====================================
# Server-side only - never exposed to browser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-tts

# =====================================
# USEAPI - FUTURE V2 (OPTIONAL / STUBBED)
# =====================================
USEAPI_TOKEN=
USEAPI_BASE_URL=https://api.useapi.net

# =====================================
# YOUTUBE - FUTURE PHASE 2 (OAUTH STUB)
# =====================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/callback/youtube

# =====================================
# META (INSTAGRAM / FACEBOOK) - FUTURE PHASE 3 (OAUTH STUB)
# =====================================
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/callback/meta

# =====================================
# AUTH & SECURITY
# =====================================
AUTH_SECRET=dev-secret-key-change-in-production-32chars
