# =====================================
# APP
# =====================================
APP_URL=https://your-app.vercel.app
NODE_ENV=production

# =====================================
# DATABASE (Neon PostgreSQL)
# Get this from: https://neon.tech → New Project → Connection String
# =====================================
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# =====================================
# GEMINI AI
# Get this from: https://aistudio.google.com/apikey
# =====================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-3.6-flash-tts

# =====================================
# VERCEL BLOB STORAGE
# Auto-generated by Vercel when you add Blob integration.
# In Vercel dashboard: Storage → Create Blob Store → it sets this automatically.
# =====================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# =====================================
# YOUTUBE OAUTH
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# =====================================
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your-secret
YOUTUBE_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback/youtube

# =====================================
# META (INSTAGRAM) - Optional
# =====================================
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback/meta

# =====================================
# AUTH & SECURITY
# Use a strong random 32+ char string in production
# Generate one: https://generate-secret.vercel.app/32
# =====================================
AUTH_SECRET=generate-a-strong-random-secret-here
