{
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "30 4 * * *"
    }
  ],
  "functions": {
    "app/api/stories/route.ts": {
      "maxDuration": 60
    },
    "app/api/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/stories/[id]/publish/youtube/route.ts": {
      "maxDuration": 60
    },
    "app/api/stories/[id]/publish/instagram/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/publish/route.ts": {
      "maxDuration": 60
    },
    "app/api/storage/cleanup/route.ts": {
      "maxDuration": 60
    }
  }
}
